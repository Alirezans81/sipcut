# =============================================================================
# SipCut backend environment. Copy to .env and fill in real values.
# =============================================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://sipcut:sipcut@localhost:5432/sipcut
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=14

# --- OTP authentication ---
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
# Return the OTP in the API response for local testing (no SMS gateway in dev).
# MUST stay false in production.
OTP_DEBUG_RETURN=true
THROTTLE_OTP=5/min

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Celery + Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=3600

# --- Object storage (S3-compatible / Arvan Cloud) ---
# Set USE_S3=true in production. When false, media is stored on local disk.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sipcut
AWS_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
AWS_S3_REGION_NAME=ir-thr-at1
AWS_S3_CUSTOM_DOMAIN=

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=200
# ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.webm,.m4v,.avi,.mkv

# --- AI provider (GapGPT) ---
# When AI_PROVIDER=gapgpt but GAPGPT_API_KEY is empty, an offline stub provider is
# used automatically (handy for local development without credentials).
AI_PROVIDER=gapgpt
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini
AI_TIMEOUT=30
